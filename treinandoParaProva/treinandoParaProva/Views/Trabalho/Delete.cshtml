@model treinandoParaProva.Models.Trabalho

@{
    ViewData["Title"] = "Excluir";
}

<h1>Excluir Trabalho</h1>

<h3>Tem certeza que deseja excluir este trabalho?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Título
        </dt>

        <dd class="col-sm-10">
            @Model.Titulo
        </dd>

        <dt class="col-sm-2">
            Área Temática
        </dt>

        <dd class="col-sm-10">
            @Model.AreaTematica
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Excluir
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>

    </form>

</div>